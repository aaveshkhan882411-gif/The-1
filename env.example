# ==============================================================================
# GrowthAI Environment Variables Template (.env.example)
# ==============================================================================
# This is a template file. Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file or any secrets to version control.
# ==============================================================================

# Application Configuration
APP_NAME=GrowthAI
APP_URL=http://localhost:3000
NODE_ENV=development

# Platform Owner Configuration
# Protected platform owner identity (enforced via secure server-side RBAC)
GROWTHAI_OWNER_EMAIL=aaveshkhan882411@gmail.com

# Authentication (Google OAuth & Session Secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
AUTH_SECRET=generate_a_secure_random_string_for_sessions

# Security & Encryption
ENCRYPTION_KEY=generate_a_secure_32_byte_hex_or_base64_key

# Database Configuration (Self-hostable database)
# Example: postgresql://user:password@localhost:5432/growthai
DATABASE_URL=

# PayPal Payment Integration
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Use 'sandbox' for testing or 'live' for production
PAYPAL_ENVIRONMENT=sandbox

# Email Communication Configuration
EMAIL_FROM=noreply@growthai.com
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Communication Infrastructure (WhatsApp & Voice Adapters - Optional/Generic)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
VOICE_GATEWAY_URL=
VOICE_GATEWAY_TOKEN=

# Storage, Caching, and Queue Configuration (Self-hostable)
REDIS_URL=
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=

# Monitoring & Logging (Optional)
LOG_LEVEL=info
MONITORING_ENDPOINT=
