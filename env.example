# ==============================================================================
# GrowthAI Environment Variables Template (.env.example)
# ==============================================================================
# This is a template file.
# Copy this file to .env and fill in your actual values.
#
# NEVER commit the real .env file or any secrets to version control.
# ==============================================================================

# ==============================================================================
# Application Configuration
# ==============================================================================

APP_NAME=GrowthAI
APP_URL=http://localhost:3000
NODE_ENV=development

# ==============================================================================
# Platform Owner Configuration
# ==============================================================================

# Protected platform owner identity.
# Enforced through secure server-side RBAC.
GROWTHAI_OWNER_EMAIL=aaveshkhan882411@gmail.com

# ==============================================================================
# Authentication
# ==============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Server-side session/authentication secret.
# Replace this placeholder with a strong random secret.
AUTH_SECRET=generate_a_secure_random_string_for_sessions

# ==============================================================================
# Security & Encryption
# ==============================================================================

# Strong 32-byte encryption key.
# Use a cryptographically secure random value in production.
ENCRYPTION_KEY=generate_a_secure_32_byte_hex_or_base64_key

# ==============================================================================
# Database Configuration
# ==============================================================================

# Self-hosted PostgreSQL database.
#
# Example:
# postgresql://username:password@localhost:5432/growthai
#
# Do NOT expose DATABASE_URL to the browser.
DATABASE_URL=

# ==============================================================================
# PayPal Payment Integration
# ==============================================================================

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Use "sandbox" for testing.
# Use "live" for production.
PAYPAL_ENVIRONMENT=sandbox

# ==============================================================================
# Email Communication
# ==============================================================================

EMAIL_FROM=noreply@growthai.com
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# ==============================================================================
# Communication Infrastructure
# ==============================================================================

# WhatsApp
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Voice Gateway
VOICE_GATEWAY_URL=
VOICE_GATEWAY_TOKEN=

# ==============================================================================
# Redis / Cache / Queue Configuration
# ==============================================================================

# Generic Redis connection URL.
# Can be used by other Redis-compatible infrastructure.
REDIS_URL=

# Upstash Redis REST configuration.
# Required by the distributed/serverless rate limiter.
#
# Get these values from your Upstash Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================================================================
# Storage Configuration
# ==============================================================================

# Default local storage provider.
# Change this only when another storage adapter is implemented/configured.
STORAGE_PROVIDER=local

STORAGE_BUCKET_NAME=

# ==============================================================================
# Monitoring & Logging
# ==============================================================================

LOG_LEVEL=info
MONITORING_ENDPOINT=
