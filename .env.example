# ==========================================
# GROWTHAI CORE ENVIRONMENT CONFIGURATION
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/growthai_db

# Local Self-Hosted AI Runtime Inference
AI_BASE_URL=http://localhost:8000/v1
AI_API_KEY=growthai-local-secret-key
AI_MODEL=growthai-sales-7b

# PayPal Gateway Credentials
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=sandbox # Set to 'production' in live deployment
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Application Secrets
JWT_SECRET=super_secure_growthai_jwt_secret_key
NODE_ENV=development

